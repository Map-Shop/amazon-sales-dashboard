{
  "crons": [
    {
      "path": "/api/sessions?action=sync",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/transactions?action=sync-v2024",
      "schedule": "0 10 3 * *"
    },
    {
      "path": "/api/adspend?action=sync-request",
      "schedule": "10 10 3 * *"
    },
    {
      "path": "/api/adspend?action=sync-collect",
      "schedule": "0 12 3 * *"
    },
    {
      "path": "/api/shipping?action=sync",
      "schedule": "0 13 3 * *"
    },
    {
      "path": "/api/orders?action=cron-daily-request",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/orders?action=cron-collect&slot=1",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/orders?action=cron-collect&slot=2",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/orders?action=cron-collect&slot=3",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/orders?action=cron-data-check",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/adspend?action=cron-ads-request",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/adspend?action=cron-ads-collect",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/adspend?action=cron-ads-collect&slot=2&final=1",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/adcampaigns?action=cron-refresh",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/adspend?action=cron-monthly-request",
      "schedule": "0 9 15 * *"
    },
    {
      "path": "/api/adspend?action=cron-monthly-collect",
      "schedule": "0 10 15 * *"
    },
    {
      "path": "/api/adspend?action=cron-monthly-collect&slot=2&final=1",
      "schedule": "0 13 15 * *"
    }
  ],
  "functions": {
    "api/orders.js": {
      "maxDuration": 300
    },
    "api/transactions.js": {
      "maxDuration": 300
    },
    "api/adspend.js": {
      "maxDuration": 60
    },
    "api/adcampaigns.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
